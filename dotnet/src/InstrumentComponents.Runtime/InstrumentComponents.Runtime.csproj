<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.3.0-alpha.1</Version>
    <Description>Experimental protocol-neutral device registration and sync, native async and dedicated worker session runtime.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/josh-hemphill/instrument-components</RepositoryUrl>
  <PackageReadmeFile>README.md</PackageReadmeFile><PackageProjectUrl>https://github.com/josh-hemphill/instrument-components/blob/driver-sdk-v0.3.0-alpha.1/docs-site/docs/getting-started.md</PackageProjectUrl></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../InstrumentComponents.Abstractions/InstrumentComponents.Abstractions.csproj" />
  </ItemGroup>
  <Import Project="../../DriverSdk.Package.targets" />
  <ItemGroup><None Include="../../README.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
