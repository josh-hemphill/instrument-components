<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstrumentComponents.OpenTap</RootNamespace>
    <AssemblyName>InstrumentComponents.OpenTap</AssemblyName>
    <PackageId>InstrumentComponents.OpenTap</PackageId>
    <Version>0.1.1</Version>
    <Authors>josh-hemphill</Authors>
    <Description>OpenTAP instruments and typed SCPI steps with host-injected I/O.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/josh-hemphill/instrument-components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/josh-hemphill/instrument-components</RepositoryUrl>
    <PackageTags>opentap;visa;scpi;instrument;test-equipment</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <OpenTapPackageDefinitionPath>package.xml</OpenTapPackageDefinitionPath>
    <!-- OpenTAP's props enable this for Release. Keep it opt-in: tap CLI needs net9. -->
    <CreateOpenTapPackage>false</CreateOpenTapPackage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTAP" Version="9.32.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstrumentComponents\InstrumentComponents.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
