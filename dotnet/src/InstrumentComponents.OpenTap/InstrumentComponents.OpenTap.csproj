<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstrumentComponents.OpenTap</RootNamespace>
    <AssemblyName>InstrumentComponents.OpenTap</AssemblyName>
    <OpenTapPackageDefinitionPath>package.xml</OpenTapPackageDefinitionPath>
    <!-- tap package create needs a net9 runtime; pass -p:CreateOpenTapPackage=true on a net9 host. -->
    <CreateOpenTapPackage Condition="'$(CreateOpenTapPackage)' == ''">false</CreateOpenTapPackage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTAP" Version="9.32.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstrumentComponents\InstrumentComponents.csproj" />
  </ItemGroup>

</Project>
