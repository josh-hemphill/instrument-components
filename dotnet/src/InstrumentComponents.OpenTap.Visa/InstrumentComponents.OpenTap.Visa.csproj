<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstrumentComponents.OpenTap.Visa</RootNamespace>
    <AssemblyName>InstrumentComponents.OpenTap.Visa</AssemblyName>
    <PackageId>InstrumentComponents.OpenTap.Visa</PackageId>
    <Version>0.1.1</Version>
    <Authors>josh-hemphill</Authors>
    <Description>Optional VISA I/O provider for standalone InstrumentComponents OpenTAP execution.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/josh-hemphill/instrument-components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/josh-hemphill/instrument-components</RepositoryUrl>
    <PackageTags>opentap;visa;scpi;instrument;test-equipment</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstrumentComponents.OpenTap\InstrumentComponents.OpenTap.csproj" />
    <ProjectReference Include="..\InstrumentComponents.Visa\InstrumentComponents.Visa.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
