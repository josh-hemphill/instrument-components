<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstrumentComponents</RootNamespace>
    <AssemblyName>InstrumentComponents</AssemblyName>
    <PackageId>InstrumentComponents</PackageId>
    <Version>0.3.0-alpha.1</Version>
    <Authors>josh-hemphill</Authors>
    <Description>High-level instrument discovery and typed IVI-inspired classes — VISA-agnostic core with mock fixtures for CI.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/josh-hemphill/instrument-components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/josh-hemphill/instrument-components</RepositoryUrl>
    <PackageTags>visa;scpi;instrument;test-equipment;dmm;ivi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>



  <ItemGroup><ProjectReference Include="../InstrumentComponents.Runtime/InstrumentComponents.Runtime.csproj" /></ItemGroup>
  <Import Project="../../DriverSdk.Package.targets" />

  <ItemGroup>
    <InternalsVisibleTo Include="InstrumentComponents.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
