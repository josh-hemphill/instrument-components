<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InstrumentComponentsPackageVersion Condition="'$(InstrumentComponentsPackageVersion)' == ''">0.1.1</InstrumentComponentsPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="InstrumentComponents" Version="$(InstrumentComponentsPackageVersion)" />
    <PackageReference Include="InstrumentComponents.Visa" Version="$(InstrumentComponentsPackageVersion)" />
  </ItemGroup>
</Project>
