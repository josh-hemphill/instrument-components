{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/josh-hemphill/instrument-components/spec/opentap-operations.schema.json",
  "title": "OpenTAP operation catalog",
  "description": "Curated typed-class operations exposed as OpenTAP TestStep types. Public stepTypeName values are TapPlan contract.",
  "type": "object",
  "required": ["version", "operations"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "instrumentKind": {
      "enum": [
        "Dmm",
        "DcPowerSupply",
        "FunctionGenerator",
        "Oscilloscope",
        "Switch",
        "Counter",
        "PowerMeter",
        "SpectrumAnalyzer",
        "Scpi"
      ]
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "stepTypeName",
        "implementation",
        "kind",
        "instrumentKind",
        "instrumentType",
        "displayName",
        "displayGroups",
        "publish",
        "since"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "stepTypeName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Step$" },
        "implementation": { "enum": ["handwritten", "generated"] },
        "kind": { "enum": ["invoke", "composite", "utility"] },
        "instrumentKind": { "$ref": "#/$defs/instrumentKind" },
        "instrumentType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "accessor": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "displayGroups": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "capability": { "enum": ["base", "extension"] },
        "since": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "invoke": { "$ref": "#/$defs/invoke" },
        "composite": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/invoke" }
        },
        "publish": { "$ref": "#/$defs/publish" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "invoke" } } },
          "then": { "required": ["invoke", "accessor"] }
        },
        {
          "if": { "properties": { "kind": { "const": "composite" } } },
          "then": { "required": ["composite", "accessor"] }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["name", "displayName", "type", "order"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["string", "int", "uint", "double", "bool", "nullableDouble", "enum"]
        },
        "enumType": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 2 },
        "unit": { "type": "string", "minLength": 1 },
        "default": true
      }
    },
    "invoke": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "returns": { "enum": ["void", "double", "bool", "trace"] },
        "dialectKey": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["parameter"],
            "additionalProperties": false,
            "properties": {
              "parameter": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["none", "identity", "sample", "scalar", "sampleAndScalar", "multiScalar"]
        },
        "unit": { "type": "string" },
        "supportsLimits": { "type": "boolean" }
      }
    }
  }
}
