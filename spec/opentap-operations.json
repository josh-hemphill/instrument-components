        { "name": "CurrentLimit", "displayName": "Current limit", "type": "double", "order": 4, "unit": "A", "default": 0 },
        { "name": "OutputEnabled", "displayName": "Output enabled", "type": "bool", "order": 5, "default": true }
      ],
      "composite": [
        { "method": "SetVoltage", "returns": "void", "dialectKey": "set_voltage", "args": [{ "parameter": "Channel" }, { "parameter": "Voltage" }] },
        { "method": "SetCurrentLimit", "returns": "void", "dialectKey": "set_current_limit", "args": [{ "parameter": "Channel" }, { "parameter": "CurrentLimit" }] },
        { "method": "OutputEnable", "returns": "void", "dialectKey": "output_enable", "args": [{ "parameter": "Channel" }, { "parameter": "OutputEnabled" }] }
      ],
      "publish": { "mode": "multiScalar" }
