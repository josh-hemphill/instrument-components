      "steps": [],
      "closes": 1,
      "shutdowns": 0
    },
    {
      "id": "CAP-required-actual-subset",
      "envelope": "withSense",
      "requiredSense": true,
      "openError": "UnsupportedOperation",
      "opens": 1,
      "steps": [],
      "closes": 1,
      "shutdowns": 0
    },
    {
      "id": "CAP-cleanup-failure",
      "missingDmm": true,
      "failClose": true,
      "openError": "DriverContractViolation",
      "opens": 1,
      "steps": [],
      "closes": 1,
      "shutdowns": 0
    },
    {
