        "1": false,
        "2": false
      }
    },
    {
      "id": "CAP-disabled-reset",
      "disabledOperations": [
        "Reset"
      ],
      "steps": [
        {
          "action": "reset",
          "error": "UnsupportedOperation"
        },
        {
          "action": "close"
        }
      ],
      "closes": 1,
      "shutdowns": 0,
      "noIo": true
    },
    {
      "id": "SAFE-no-escalate",
      "steps": [
        {
          "action": "close"
        },
        {
          "action": "close",
          "shutdown": true,
          "error": "Shutdown"
        },
        {
          "action": "close"
        }
      ],
      "closes": 1,
      "shutdowns": 0
    },
    {
      "id": "SAFE-repeat-failure",
      "steps": [
        {
          "action": "fail-shutdown"
        },
        {
          "action": "close",
          "shutdown": true,
          "error": "Shutdown"
        },
        {
          "action": "close",
          "shutdown": true,
          "error": "Shutdown"
        },
        {
          "action": "close",
